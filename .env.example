# Copy to .env and fill in real values. Never commit the real .env.

# Postgres (Neon) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Redis (Upstash REST)
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# Anthropic (Claude) API key
ANTHROPIC_API_KEY="sk-ant-..."

# Models
CLAUDE_MODEL_BULK="claude-haiku-4-5"
CLAUDE_MODEL_QUALITY="claude-opus-4-8"

# Summarization provider: groq (free) | anthropic
LLM_PROVIDER="groq"
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"
MAX_ITEMS_PER_SOURCE=30
# Never summarize articles older than this (days). Keeps a daily-news app from
# drafting cards out of a blog's back-catalogue. Raise it to mine the archive.
MAX_ARTICLE_AGE_DAYS=21

# API
API_PORT=4000
# Guards the admin REST endpoints (sent as the x-admin-token header)
ADMIN_TOKEN="choose-a-long-random-string"

# Admin panel login — password for the Next.js UI at :4001.
# Generate one with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# If unset, the admin panel refuses all access (fails closed).
ADMIN_PASSWORD="choose-a-long-random-password"

# ---- Auth (mobile login / Google SSO) ----
# Signs the app's JWTs. Use a long random string in production.
AUTH_JWT_SECRET="choose-a-long-random-string"
# Google OAuth "Web application" client ID. When set, the server verifies REAL
# Google ID tokens; when empty, it accepts the built-in mock identity (dev only).
# Must match the mobile app's EXPO_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=""

# ---- Media (self-hosted card images) ----
# Free Pexels API key (https://www.pexels.com/api/) — commercial use OK, no
# attribution required. When empty, cards fall back to bundled seed placeholders.
PEXELS_API_KEY=""
# Where downloaded images are stored/served from. Leave unset to use the default
# (services/api/media). In Docker this path is a mounted volume.
# MEDIA_DIR="/app/services/api/media"

# ---- Docker Postgres (used by docker-compose.yml) ----
# The bundled postgres container's credentials. docker-compose overrides
# DATABASE_URL to point services at this container, so these are what matter there.
POSTGRES_USER="aishorts"
POSTGRES_PASSWORD="aishorts"
POSTGRES_DB="aishorts"
# Host port to expose the container's Postgres on (5432 is often taken locally).
POSTGRES_PORT=5433
