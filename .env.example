# Copy to .env and fill in real values. Never commit the real .env.

# Postgres (Neon) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Redis (Upstash REST)
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# Anthropic (Claude) API key
ANTHROPIC_API_KEY="sk-ant-..."

# Models
CLAUDE_MODEL_BULK="claude-haiku-4-5"
CLAUDE_MODEL_QUALITY="claude-opus-4-8"

# Summarization provider: groq (free) | anthropic
LLM_PROVIDER="groq"
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"
MAX_ITEMS_PER_SOURCE=30
# Never summarize articles older than this (days). Keeps a daily-news app from
# drafting cards out of a blog's back-catalogue. Raise it to mine the archive.
MAX_ARTICLE_AGE_DAYS=21

# API
API_PORT=4000
# Guards the admin REST endpoints (sent as the x-admin-token header)
ADMIN_TOKEN="choose-a-long-random-string"

# Admin panel login — password for the Next.js UI at :4001.
# Generate one with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# If unset, the admin panel refuses all access (fails closed).
ADMIN_PASSWORD="choose-a-long-random-password"
