# AIShorts mobile (Expo) build-time env.
# Copy to `.env` in this directory. Expo inlines EXPO_PUBLIC_* at build time, so
# these are baked into the APK you build. You can also override the backend URL at
# runtime from the in-app Settings screen (no rebuild needed).

# Backend base URL the app talks to.
#  - Local dev on the same machine (web/simulator):  http://localhost:4000
#  - Android emulator reaching the Mac host:          http://10.0.2.2:4000
#  - Real device over the internet (Phase 1):         https://<your-cloudflare-tunnel-host>
#  - Cloud backend (Phase 2):                         https://<your-cloud-host>
# Release APKs block cleartext HTTP, so use an HTTPS tunnel/host for devices.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In (optional). Leave blank to keep the built-in mock sign-in.
# Uses @react-native-google-signin/google-signin (native — requires the built APK,
# not Expo Go). Create OAuth 2.0 Client IDs in Google Cloud Console:
#   - "Web application" client -> put its ID here AND in the server's GOOGLE_CLIENT_ID
#     (the id_token's `aud` must match). This is the only value the app passes.
#   - "Android" client: create one with the app's package (com.aishorts.app) and the
#     signing key's SHA-1. You do NOT reference its ID in code — Google matches it by
#     package + SHA-1 to allow native sign-in. Get the debug SHA-1 with:
#       keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
